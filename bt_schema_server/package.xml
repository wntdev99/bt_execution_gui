<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>bt_schema_server</name>
  <version>0.1.0</version>
  <description>
    Layer 2 schema extraction ROS node. Parses behavior tree XMLs and uses
    BT.CPP factory.manifests() to produce per-tree payload schemas (external
    BB keys + types). Avoids B-11 (wait_for_action_server) by skipping
    createTree — only static XML parsing + manifest lookup.
  </description>
  <maintainer email="jeongmin.choi@wattrobotics.ai">jeongmin.choi</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>behaviortree_cpp</depend>
  <depend>behaviortree_ros2</depend>
  <depend>nlohmann-json-dev</depend>
  <depend>tinyxml2_vendor</depend>
  <depend>libtinyxml2-dev</depend>
  <depend>bt_schema_server_interfaces</depend>

  <test_depend>ament_cmake_copyright</test_depend>
  <test_depend>ament_cmake_cpplint</test_depend>
  <test_depend>ament_cmake_cppcheck</test_depend>
  <test_depend>ament_cmake_uncrustify</test_depend>
  <test_depend>ament_cmake_lint_cmake</test_depend>
  <test_depend>ament_cmake_xmllint</test_depend>
  <test_depend>ament_cmake_flake8</test_depend>
  <test_depend>ament_cmake_pep257</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
